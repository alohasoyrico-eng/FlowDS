{
  "name": "@flow/design-system",
  "version": "1.0.0-rc.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tokens": "node --test --import ./node_modules/jiti/dist/jiti.cjs src/test/node/tokens.test.ts src/test/node/semantic-tokens.test.ts src/test/node/momentum.test.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:components:coverage": "vitest run --config vitest.components.config.ts --coverage",
    "ci": "npm run format:check && npm run typecheck && npm run typecheck:test && npm run test:tokens && npm run test:components && npm run lint && npm run build:lib",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "analyze": "ANALYZE=true vite build",
    "prepublishOnly": "npm run build:lib",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "lint:css:fix": "stylelint \"src/styles/**/*.css\" --fix",
    "changeset": "changeset",
    "version:changeset": "changeset version",
    "release": "npm run build:lib && changeset publish",
    "docs:api": "typedoc",
    "docs:api:watch": "typedoc --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@chromatic-com/storybook": "^5.1.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "20.11.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/browser": "^3.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.3.3",
    "jsdom": "^26.1.0",
    "lucide-react": "0.487.0",
    "playwright": "^1.59.0",
    "prettier": "^3.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "^10.3.3",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tsc-alias": "^1.8.16",
    "typedoc": "^0.28.18",
    "typescript": "5.4.2",
    "typescript-eslint": "^8.58.0",
    "vite": "6.3.5",
    "vitest": "^3.1.0",
    "vitest-axe": "^0.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "*"
  },
  "engines": {
    "node": ">=18"
  }
}
