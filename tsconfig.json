{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@flow/tokens": ["packages/tokens/src"],
      "@flow/icons": ["packages/icons/src"],
      "@flow/flags": ["packages/flags/src"],
      "@flow/primitives": ["packages/primitives/src"],
      "@flow/components": ["packages/components/src"],
      "@flow/patterns": ["packages/patterns/src"],
      "@flow/design-system": ["packages/flow/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/imports", "src/test", "vitest.config.ts"]
}
