{
  "name": "@flow/design-system",
  "version": "1.0.0-rc.3",
  "description": "Flow Design System — multiplatform component library for React and Flutter",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@flow/tokens": "^1.0.0-rc.3",
    "@flow/icons": "^1.0.0-rc.3",
    "@flow/flags": "^1.0.0-rc.3",
    "@flow/primitives": "^1.0.0-rc.3",
    "@flow/components": "^1.0.0-rc.3",
    "@flow/patterns": "^1.0.0-rc.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "design-system",
    "react",
    "flutter",
    "components",
    "tokens",
    "accessibility",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ER-Mobility-MX/flow.git",
    "directory": "packages/flow"
  },
  "homepage": "https://github.com/ER-Mobility-MX/flow",
  "bugs": {
    "url": "https://github.com/ER-Mobility-MX/flow/issues"
  }
}
