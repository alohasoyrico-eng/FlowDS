{
  "name": "@flow/patterns",
  "version": "1.0.0-rc.3",
  "description": "Flow Design System — L4 pattern compositions (DataTable, DatePicker, Autocomplete, etc.)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css/*": "./css/*"
  },
  "files": [
    "dist",
    "css"
  ],
  "peerDependencies": {
    "@flow/components": "^1.0.0-rc.3",
    "@flow/primitives": "^1.0.0-rc.3",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ER-Mobility-MX/flow.git",
    "directory": "packages/patterns"
  }
}
