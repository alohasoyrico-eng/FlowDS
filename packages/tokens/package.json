{
  "name": "@flow/tokens",
  "version": "1.0.0-rc.3",
  "description": "Flow Design System — design tokens (ref → sys → comp)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css": "./css/tokens.css",
    "./css/responsive": "./css/responsive.css"
  },
  "files": [
    "dist",
    "css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ER-Mobility-MX/flow.git",
    "directory": "packages/tokens"
  }
}
